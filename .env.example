# Copy to .env and set real values. NEVER commit .env.
#
# STRATA_SECRET signs console tokens. Generate one with:
#   python -c "import secrets;print(secrets.token_hex(32))"
STRATA_SECRET=change-me-to-64-random-hex-characters

# The pre-shared token operators exchange for a role token.
# Leave EMPTY only for local development — the console header and /api/health
# will both display "DEV — NO AUTH" in red so it cannot be deployed by accident.
STRATA_ADMIN_TOKEN=
